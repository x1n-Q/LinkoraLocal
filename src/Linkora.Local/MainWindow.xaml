<Window x:Class="Linkora.Local.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linkora Local"
        Width="1120"
        Height="760"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="38" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#070E18"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="29" Height="29" Margin="0,0,11,0">
            <Path Stroke="{StaticResource CyanBrush}"
                  StrokeThickness="3"
                  StrokeStartLineCap="Square"
                  StrokeEndLineCap="Square"
                  Data="M 5,3 L 5,22 L 22,22" />
            <Ellipse Width="7"
                     Height="7"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Fill="#07101C"
                     Stroke="{StaticResource LimeBrush}"
                     StrokeThickness="2" />
          </Grid>
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold">
              <Run Text="linkora" /><Run Text="." Foreground="{StaticResource LimeBrush}" />
            </TextBlock>
            <TextBlock Text="LOCAL PUBLISHER"
                       Foreground="{StaticResource CyanBrush}"
                       FontFamily="Cascadia Mono"
                       FontWeight="Bold"
                       FontSize="8" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
            <TextBlock x:Name="AccountStatusText"
                       Text="Not connected"
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold"
                       TextAlignment="Right" />
            <TextBlock x:Name="ApiEnvironmentText"
                       Text="api.linkora.top"
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="Cascadia Mono"
                       FontSize="9"
                       TextAlignment="Right" />
          </StackPanel>
          <Button x:Name="ConnectAccountButton"
                  Style="{StaticResource PrimaryButton}"
                  Content="Connect account"
                  Click="ConnectAccountButton_Click" />
          <Button x:Name="SignOutButton"
                  Margin="8,0,0,0"
                  Content="Disconnect"
                  Visibility="Collapsed"
                  Click="SignOutButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.18*" MinWidth="430" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="0.82*" MinWidth="330" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="LOCALHOST FOUND"
                         Foreground="{StaticResource CyanBrush}"
                         FontFamily="Cascadia Mono"
                         FontWeight="Bold"
                         FontSize="9" />
              <TextBlock Text="Running services"
                         Margin="0,7,0,0"
                         FontSize="28"
                         FontWeight="Bold" />
              <TextBlock Text="Only HTTP services are shown. Database, SSH, and other sensitive ports are excluded."
                         Margin="0,7,0,0"
                         Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="↻  Scan again"
                    Click="RefreshButton_Click" />
          </Grid>

          <Border x:Name="ScanningPanel"
                  CornerRadius="12"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  Padding="22"
                  Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="●"
                         Foreground="{StaticResource CyanBrush}"
                         FontSize="16"
                         Margin="0,0,12,0" />
              <TextBlock Text="Inspecting local listening ports…"
                         Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border x:Name="NoServicesPanel"
                  CornerRadius="12"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  Padding="26"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="No web services detected"
                         FontSize="17"
                         FontWeight="SemiBold" />
              <TextBlock Margin="0,8,0,0"
                         Text="Start a development server such as npm run dev, then scan again."
                         Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
          </Border>

          <ListBox x:Name="LocalServicesList"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionChanged="LocalServicesList_SelectionChanged">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ServiceBorder"
                              Padding="18"
                              CornerRadius="11"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ServiceBorder" Property="BorderBrush" Value="#47708A" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="ServiceBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                          <Setter TargetName="ServiceBorder" Property="Background" Value="#102433" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="42"
                          Height="42"
                          CornerRadius="9"
                          Background="#10283A"
                          BorderBrush="#28516A"
                          BorderThickness="1">
                    <TextBlock Text="&gt;_"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProcessLabel}"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PortLabel}"
                               FontFamily="Cascadia Mono"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"
                               TextAlignment="Right" />
                    <TextBlock Text="READY"
                               Margin="0,5,0,0"
                               FontFamily="Cascadia Mono"
                               Foreground="{StaticResource LimeBrush}"
                               FontSize="8"
                               TextAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border x:Name="DeviceCodePanel"
                  Margin="0,0,0,14"
                  Padding="20"
                  CornerRadius="12"
                  Background="#102433"
                  BorderBrush="{StaticResource CyanBrush}"
                  BorderThickness="1"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="AUTHORIZE THIS COMPUTER"
                         Foreground="{StaticResource CyanBrush}"
                         FontFamily="Cascadia Mono"
                         FontWeight="Bold"
                         FontSize="9" />
              <TextBlock x:Name="DeviceCodeText"
                         Margin="0,12,0,0"
                         FontFamily="Cascadia Mono"
                         FontWeight="Bold"
                         FontSize="25" />
              <TextBlock Text="Confirm that this code matches the Linkora page opened in your browser."
                         Margin="0,10,0,0"
                         Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" />
              <Button x:Name="OpenBrowserButton"
                      Margin="0,14,0,0"
                      Content="Open authorization page"
                      Click="OpenBrowserButton_Click" />
            </StackPanel>
          </Border>

          <Border Padding="22"
                  CornerRadius="12"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1">
            <StackPanel>
              <TextBlock Text="PUBLISH CONTROL"
                         Foreground="{StaticResource CyanBrush}"
                         FontFamily="Cascadia Mono"
                         FontWeight="Bold"
                         FontSize="9" />
              <TextBlock Text="Secure preview"
                         Margin="0,8,0,0"
                         FontSize="23"
                         FontWeight="Bold" />
              <TextBlock Text="No router configuration or public inbound port is required."
                         Margin="0,7,0,18"
                         Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" />

              <Border x:Name="SignedOutPanel"
                      Padding="17"
                      CornerRadius="9"
                      Background="#07101C"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Connect your Linkora account"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Approval happens in your browser. The app never receives your password."
                             Margin="0,7,0,0"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             FontSize="11" />
                </StackPanel>
              </Border>

              <StackPanel x:Name="PublishConfigurationPanel" Visibility="Collapsed">
                <TextBlock Text="LOCAL SERVICE"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Cascadia Mono"
                           FontSize="9"
                           FontWeight="Bold" />
                <Border Margin="0,7,0,16"
                        Padding="13"
                        Background="#07101C"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                  <TextBlock x:Name="SelectedServiceText"
                             Text="Select a service on the left"
                             FontFamily="Cascadia Mono"
                             Foreground="{StaticResource CyanBrush}" />
                </Border>

                <StackPanel x:Name="ExistingHostnamePanel">
                  <TextBlock Text="EXISTING HOSTNAME"
                             Foreground="{StaticResource MutedBrush}"
                             FontFamily="Cascadia Mono"
                             FontSize="9"
                             FontWeight="Bold" />
                  <ComboBox x:Name="ExistingHostnameCombo"
                            Margin="0,7,0,12"
                            SelectionChanged="ExistingHostnameCombo_SelectionChanged" />
                </StackPanel>

                <CheckBox x:Name="CreateNewHostnameCheckBox"
                          Margin="0,0,0,14"
                          Content="Create a new hostname"
                          Checked="CreateNewHostnameCheckBox_Changed"
                          Unchecked="CreateNewHostnameCheckBox_Changed" />

                <StackPanel x:Name="NewHostnamePanel" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.05*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="HOSTNAME LABEL"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontFamily="Cascadia Mono"
                                 FontSize="9"
                                 FontWeight="Bold" />
                      <TextBox x:Name="HostnameLabelTextBox"
                               Margin="0,7,0,0"
                               MaxLength="63"
                               TextChanged="HostnameLabelTextBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="DOMAIN POOL"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontFamily="Cascadia Mono"
                                 FontSize="9"
                                 FontWeight="Bold" />
                      <ComboBox x:Name="DomainPoolCombo"
                                Margin="0,7,0,0"
                                SelectionChanged="DomainPoolCombo_SelectionChanged" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="HostnamePreviewText"
                             Margin="0,8,0,0"
                             Foreground="{StaticResource CyanBrush}"
                             FontFamily="Cascadia Mono"
                             FontSize="10" />
                </StackPanel>

                <Border Margin="0,18,0,16"
                        Padding="14"
                        CornerRadius="8"
                        Background="#162012"
                        BorderBrush="#3E5B24"
                        BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓"
                               Margin="0,0,10,0"
                               Foreground="{StaticResource LimeBrush}"
                               FontWeight="Bold" />
                    <TextBlock Text="Recommended: managed tunnel with no open inbound ports."
                               Foreground="#C8E8A2"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Button x:Name="PublishButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Publish securely"
                        IsEnabled="False"
                        Click="PublishButton_Click" />

                <StackPanel x:Name="PublishedPanel"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                  <Border Padding="14"
                          CornerRadius="8"
                          BorderBrush="#426526"
                          BorderThickness="1"
                          Background="#14200F">
                    <StackPanel>
                      <TextBlock Text="ONLINE"
                                 Foreground="{StaticResource LimeBrush}"
                                 FontFamily="Cascadia Mono"
                                 FontSize="9"
                                 FontWeight="Bold" />
                      <TextBlock x:Name="PublishedUrlText"
                                 Margin="0,7,0,0"
                                 Foreground="{StaticResource TextBrush}"
                                 FontFamily="Cascadia Mono"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Open"
                            Click="OpenPublishedButton_Click" />
                    <Button Grid.Column="2"
                            Content="Stop sharing"
                            Click="StopPublishingButton_Click" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="#070E18"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot"
                 Width="7"
                 Height="7"
                 Fill="{StaticResource MutedBrush}"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText"
                   Grid.Column="1"
                   Margin="9,0,0,0"
                   Text="Ready"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="LINKORA LOCAL 0.1.0"
                   Foreground="#4C6380"
                   FontFamily="Cascadia Mono"
                   FontSize="8"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
